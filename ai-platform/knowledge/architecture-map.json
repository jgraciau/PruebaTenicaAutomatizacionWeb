      "name": "Actualizar dirección de facturación",
      "source_path": "src/test/resources/features/ActualizarFacturacion.feature",
      "scenarios": [
        {
          "id": "scenario:src/test/resources/features/ActualizarFacturacion.feature:4",
          "feature_id": "feature:src/test/resources/features/ActualizarFacturacion.feature",
          "name": "Cambiar dirección y ciudad de facturación",
          "steps": [
            "el usuario carga la informacion desde el Excel \"1\"",
            "el usuario esta en la pagina de bonBonite",
            "inicia sesion con su usuario",
            "actualiza su direccion de facturacion a \"Cr 67 #54-77\" y ciudad \"Itagui\"",
            "debe confirmar que la direccion de facturacion quedo guardada como \"Cr 67 #54-77\" en la ciudad \"Itagui\""
          ]
        }
      ]
    },
    {
